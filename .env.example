# Copiar como .env y completar. El archivo .env NUNCA se sube al repositorio (Tabla 4.26, "Secretos").

# El entorno lo elige cada punto de entrada: manage.py usa config.settings.local, pytest usa
# config.settings.test y Gunicorn (wsgi.py) usa config.settings.produccion. En el servidor de pruebas,
# definir DJANGO_SETTINGS_MODULE=config.settings.pruebas en el servicio, no aquí.

# Clave secreta: generar una distinta por entorno con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-esta-clave

# Hosts permitidos (separados por coma). En producción, el dominio del local.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos SQL Server (decisión D-09)
DB_NOMBRE=Dogtor
# Instancia: localhost\SQLEXPRESS (Express con nombre de instancia) o localhost (instancia predeterminada)
DB_HOST=localhost\SQLEXPRESS
# Puerto: vacío para instancias con nombre; 1433 si se conecta por puerto (por ejemplo, Docker)
DB_PUERTO=
# Cuenta SQL creada por bd/00_crear_base_y_usuario.sql. Deje DB_USUARIO vacío para usar su cuenta de Windows.
DB_USUARIO=dogtor_app
DB_CONTRASENA=Cambiar-Esta-Contrasena-2026
DB_DRIVER=ODBC Driver 18 for SQL Server
# si = confiar en el certificado autofirmado del servidor local; en producción use un certificado válido y ponga no
DB_CONFIAR_CERTIFICADO=si

# Respaldos (S0-21, RNF-04)
# Carpeta donde SQL Server escribe el .bak: debe ser una ruta ABSOLUTA del equipo del servidor y la
# cuenta del servicio de SQL Server debe poder escribir en ella (por ejemplo C:\DogtorRespaldos).
RESPALDO_DIR=C:\DogtorRespaldos
RESPALDO_COPIA_EXTERNA=
RESPALDO_DIAS_RETENCION=30

# Contraseña de las cuentas ficticias que crea `cargar_datos_prueba` (solo local y pruebas)
DATOS_PRUEBA_CONTRASENA=Dogtor-Prueba-2026
