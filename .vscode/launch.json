{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: servidor local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver"],
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Pytest: archivo actual",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-v"],
      "justMyCode": false
    }
  ]
}
