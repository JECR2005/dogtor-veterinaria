# S0-08 · Nada de secretos ni archivos generados en el repositorio (Tabla 4.26, R06)

# Secretos y configuración local
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
reporte-pruebas.xml
.ruff_cache/

# Django
/staticfiles/
/media/
*.log

# Bitácoras de las tareas programadas y del monitor (S5-08, S5-10): se quedan en el equipo
/logs/

# Respaldos (contienen datos personales: nunca al repositorio, RNF-08)
respaldos/
*.bak
*.trn
*.sql.gz

# Editores y sistema
.idea/
.vs/
.DS_Store
Thumbs.db

# Entorno con https en Docker (S5-12): secretos generados y certificado local, nunca al repositorio
docker/produccion.env
docker/certs/
# Reportes de OWASP ZAP: se suben a mano los que se citan en la evaluación
docs/gestion/zap/*.html
